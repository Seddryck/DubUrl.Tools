<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="ConnectionUrls/ConnectionUrlCatalog.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>DubUrl.Cli</AssemblyName>
    <RootNamespace>DubUrl.Cli</RootNamespace>
    <ApplicationIcon>..\misc\icon\duburl.ico</ApplicationIcon>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>duburl</ToolCommandName>
    <PackageId>DubUrl-cli</PackageId>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-musl-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NoWarn>$(NoWarn);NU5118</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.3" />
    <PackageReference Include="CredOS" Version="0.1.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.CommandLine" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DubUrl.Application\DubUrl.Application.csproj" />
    <PackageReference Include="DubUrl.Authentication.SqlServer" Version="[$(DubUrlLibraryVersion)]" />
    <PackageReference Include="DubUrl.Authentication.Snowflake" Version="[$(DubUrlLibraryVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="connector-catalog.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('connector-catalog.json')" />
    <EmbeddedResource Include="ConnectionUrls/connection-url-catalog.zip" LogicalName="DubUrl.Cli.ConnectionUrlCatalog.zip" />
  </ItemGroup>

  <Target Name="VerifyConnectionUrlCatalog" BeforeTargets="PrepareForBuild">
    <VerifyFileHash File="$(MSBuildProjectDirectory)/ConnectionUrls/connection-url-catalog.zip" Hash="$(ConnectionUrlCatalogSha256)" />
  </Target>

</Project>
